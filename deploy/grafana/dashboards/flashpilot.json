    {
      "type": "timeseries",
      "title": "未成交的原因",
      "description": "五个原因分开看，因为它们的处置完全不同：限流拒绝是控制面唯一能影响的那部分；风控丢弃控制面看得到但管不着（调限流对它无效）；「号源已满」是正常售罄；而「异常」不该是非零的。\n\n堆叠顺序不是随便排的：orange→blue→yellow→violet→red 这个次序跑过色盲可分辨性校验（最差相邻对 CVD ΔE 19.5）。按语义配色的第一版被判不合格 —— 绿色和橙色相邻时，红绿色盲看它们的差异只有 ΔE 2.7。",
      "targets": [
        {
          "expr": "rate(seckill_result_total{result=\"rejected\"}[1m])",
          "refId": "A",
          "legendFormat": "限流拒绝"
        },
        {
          "expr": "rate(seckill_result_total{result=\"duplicate\"}[1m])",
          "refId": "B",
          "legendFormat": "重复购买"
        },
        {
          "expr": "rate(seckill_result_total{result=\"sold_out\"}[1m])",
          "refId": "C",
          "legendFormat": "号源已满"
        },
        {
          "expr": "rate(seckill_result_total{result=\"risk_dropped\"}[1m])",
          "refId": "D",
          "legendFormat": "风控丢弃"
        },
        {
          "expr": "rate(seckill_result_total{result=\"error\"}[1m])",
          "refId": "E",
          "legendFormat": "异常"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 55,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": true,
            "gradientMode": "none",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
