  "panels": [
    {
      "type": "stat",
      "title": "当前放行阈值",
      "description": "L0 AIMD 正在使用的每秒放行上限。它是控制面唯一直接操作的旋钮。",
      "targets": [
        {
          "expr": "control_limit_qps",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
