    {
      "type": "timeseries",
      "title": "控制面动作",
      "description": "谁在动参数、动了多少次。「L1 被驳回」不是故障指标 —— 护栏（白名单/区间钳制/单次幅度/冷却期）驳回一个提案正是它该做的事。　**两条 L1 曲线是平的通常不是故障，是 Agent 没启用**（默认就是关的，需要 LLM_API_KEY）。要让它们动起来，用 `--flashpilot.control.agent.enabled=true` 启动。而「参数变更累计」那条线只要 L0 在跑就会涨 —— 如果它也是平的，那才是真的有问题（AIMD 停了）。",
      "targets": [
        {
          "expr": "control_config_version",
          "refId": "A",
          "legendFormat": "参数变更累计"
        },
        {
          "expr": "agent_decisions",
          "refId": "B",
          "legendFormat": "L1 决策累计"
        },
        {
          "expr": "agent_rejected",
          "refId": "C",
          "legendFormat": "L1 被驳回累计"
        }
      ],
      "fieldConfig": {
        "defaults": {
