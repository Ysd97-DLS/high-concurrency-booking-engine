<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.flashpilot</groupId>
    <artifactId>flashpilot</artifactId>
    <version>0.1.0</version>
    <name>flashpilot</name>
    <description>具备 AI 自治控制面的高并发秒杀系统</description>

    <properties>
        <!-- 源码保持 Java 17 兼容（简历上写的就是 17），但可以用本机 JDK 24 编译运行 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 持久层：MyBatis 负责领域 CRUD 与动态 SQL。
             starter 自带 spring-jdbc，所以下面仍可用 JdbcTemplate —— 迁移期间两者并存，
             迁完之后校验/对账那类一次性分析查询是否保留 JdbcTemplate，见 README 持久层一节。 -->
        <!-- RocketMQ：只用于支付超时释放的**定时消息**。
             它刻意不替换 Redis Stream —— 那条链路的 XADD 写在 sell_one.lua 里，
             和扣租约是同一个原子操作，拆开就是双写问题（扣了库存消息没发 = 少卖）。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers：补上 README 里自认的最大测试缺口 ——
             Lua 脚本、放号链路、护栏这些都需要真的 Redis + MySQL，
             之前只能靠压测脚本端到端验证，而端到端失败时定位不到是哪一层。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>2.2.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 集成测试（*IT）交给 failsafe，不进 surefire。
                 分开的理由很实际：单元测试要能在任何机器上秒级跑完，
                 而集成测试需要 Redis + MySQL 在跑。混在一起的话，
                 「没起 docker」和「代码写错了」会给出同一个红叉。

                 mvn test    → 只跑单元测试（215 个，几秒）
                 mvn verify  → 单元 + 集成（需要 docker compose up -d） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Testcontainers 用的 docker-java 默认按 API v1.32 请求，
                             而较新的守护进程 MinAPIVersion 已经是 1.40
                             （实测 Docker Desktop 4.78 / Engine 29.5.3：
                              /v1.32/info 返回 400，/v1.40/info 返回 200）。

                             400 的响应体恰好是个**字段全零的 Info 结构**，还带着
                             com.docker.desktop.address=npipe://... 标签，看起来极像
                             「连错了管道」—— 我因此在传输方式上白折腾了很久，
                             实际 npipe 和 tcp 两条路都是同样的 400，和传输无关。

                             注意这个值**只有系统属性认**：
                             DOCKER_API_VERSION 环境变量和 ~/.testcontainers.properties
                             里的 api.version 都不生效（实测 docker-java 照旧请求 v1.32），
                             必须走 docker-java 的 api.version 系统属性。 -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        前端构建。

        默认**不**跑：`frontend/` 的构建产物（682K / 17 个文件）直接纳入版本控制，
        输出目录就是 `src/main/resources/static/app`（见 frontend/vite.config.js 的 outDir），
        所以克隆下来 `mvn package` 就能得到一个前端可用的 jar，**不需要装 Node**。

        这是刻意的取舍。把构建产物提交进仓库通常被认为是坏实践，
        但这个项目的首要用途是「别人能不能跑起来看一眼」——
        而为了看一眼先装 Node、跑 npm install（几百 MB 依赖）门槛太高了。
        682K 换开箱可用，值得。

        改了前端代码的人用这个 profile 重新构建：

            mvn -Pfrontend package

        它要求本地有 Node（开发时用的是 v24）。也可以直接手动跑，效果完全一样：

            cd frontend && npm install && npm run build

        为什么不用 frontend-maven-plugin：它会自己下载一份 Node/npm 到 target 里。
        对 CI 是好事（环境可复现），但对「学生在自己电脑上跑一下」是纯粹的额外等待，
        而且首次构建需要联网下载 Node 发行包。
    -->
    <profiles>
        <profile>
            <id>frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/frontend</workingDirectory>
                                    <arguments><argument>install</argument></arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/frontend</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
