<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.flashpilot</groupId>
    <artifactId>flashpilot</artifactId>
    <version>0.1.0</version>
    <name>flashpilot</name>
    <description>具备 AI 自治控制面的高并发秒杀系统</description>

    <properties>
        <!-- 源码保持 Java 17 兼容（简历上写的就是 17），但可以用本机 JDK 24 编译运行 -->
        <maven.compiler.release>17</maven.compiler.release>
        <jacoco.version>0.8.13</jacoco.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 持久层：MyBatis 负责领域 CRUD 与动态 SQL。
             starter 自带 spring-jdbc，所以下面仍可用 JdbcTemplate —— 迁移期间两者并存，
             迁完之后校验/对账那类一次性分析查询是否保留 JdbcTemplate，见 README 持久层一节。 -->
        <!-- RocketMQ：只用于支付超时释放的**定时消息**。
             它刻意不替换 Redis Stream —— 那条链路的 XADD 写在 sell_one.lua 里，
             和扣租约是同一个原子操作，拆开就是双写问题（扣了库存消息没发 = 少卖）。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers：补上 README 里自认的最大测试缺口 ——
             Lua 脚本、放号链路、护栏这些都需要真的 Redis + MySQL，
             之前只能靠压测脚本端到端验证，而端到端失败时定位不到是哪一层。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>2.2.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 接口自动化。选 RestAssured 而不是 MockMvc：MockMvc 不经过真实的
             HTTP 栈（不走 Servlet 容器、不做真实的序列化与状态码协商），
             而这批用例要验的恰恰包括「没有令牌时服务端返回什么状态码」
             「别人的凭证号打过来回显不回显状态」这类**协议层**行为。 -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 抢号是异步落库（Redis Stream → 消费者 → MySQL），断言必须等消费追平。
             用 Awaitility 而不是 Thread.sleep：固定睡眠要么不够（偶发红）
             要么过长（每条用例都在等），两种都会让人开始忽略这批测试。 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 声明它只有一个目的：保证 agent jar 一定被下载进本地仓库，
             上面 argLine 里那条手写路径才指得到东西。它不参与任何 classpath。 -->
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.agent</artifactId>
            <version>${jacoco.version}</version>
            <classifier>runtime</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 集成测试（*IT）交给 failsafe，不进 surefire。
                 分开的理由很实际：单元测试要能在任何机器上秒级跑完，
                 而集成测试需要 Redis + MySQL 在跑。混在一起的话，
                 「没起 docker」和「代码写错了」会给出同一个红叉。

                 mvn test    → 只跑单元测试（215 个，几秒）
                 mvn verify  → 单元 + 集成（需要 docker compose up -d） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${settings.localRepository}/org/jacoco/org.jacoco.agent/${jacoco.version}/org.jacoco.agent-${jacoco.version}-runtime.jar=destfile=target/jacoco-it.exec,append=false</argLine>
                    <systemPropertyVariables>
                        <!-- Testcontainers 用的 docker-java 默认按 API v1.32 请求，
                             而较新的守护进程 MinAPIVersion 已经是 1.40
                             （实测 Docker Desktop 4.78 / Engine 29.5.3：
                              /v1.32/info 返回 400，/v1.40/info 返回 200）。

                             400 的响应体恰好是个**字段全零的 Info 结构**，还带着
                             com.docker.desktop.address=npipe://... 标签，看起来极像
                             「连错了管道」—— 我因此在传输方式上白折腾了很久，
                             实际 npipe 和 tcp 两条路都是同样的 400，和传输无关。

                             注意这个值**只有系统属性认**：
                             DOCKER_API_VERSION 环境变量和 ~/.testcontainers.properties
                             里的 api.version 都不生效（实测 docker-java 照旧请求 v1.32），
                             必须走 docker-java 的 api.version 系统属性。 -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 覆盖率。加它的目的不是把数字做好看，而是回答一个具体问题：
                 「判定逻辑里哪些分支从来没有被任何一条单测走到过」。
                 覆盖率高不等于测得好（等式③那类缺陷靠行覆盖率发现不了），
                 但覆盖率低的地方一定没被测过 —— 它只在这个方向上可信。

                 报告：target/site/jacoco/index.html（mvn test 后生成）
                       target/site/jacoco-it/index.html（mvn verify 后生成，需要 docker）

                 ⚠ 这里**没有用 prepare-agent**，是被迫的，不是偏好：
                 prepare-agent 会把 destFile 展开成绝对路径再塞进 -javaagent 参数，
                 而本仓库的绝对路径含中文（D:\后端学习路线…）。Maven 用 GBK 编码子进程
                 命令行、fork 出的 JVM 按 CP1252 解回，路径当场变成
                 「D:\ºó¶Ëѧϰ·Ïß20260724\…」—— agent 于是在 D 盘根目录造出一个乱码
                 目录写进去，**主构建全程不报错**，只在 report 阶段留下一句
                 「missing execution data file」，很容易被当成插件没生效。
                 手写 argLine 并使用**相对**的 destfile 后，参数串全是 ASCII，
                 子进程按自己的工作目录（basedir）落盘，编码问题不复存在。
                 report 目标跑在 Maven 自己的 JVM 里，不经过命令行，所以照旧用绝对路径。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>report-integration</goal></goals>
                    </execution>
                    <!-- 合并口径。分开看两份报告会漏掉一件事：一个类可能单测没碰、
                         集成测试碰了，两边各自看都像「没测」，合起来才是真相。
                         合并报告是 `mvn verify` 之后唯一该对外引用的那个数字。 -->
                    <execution>
                        <id>merge-exec</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-merged</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- 门禁。作用是「不许再退步」，不是「必须达到某个行业标准」。
                         阈值取实测值下方一档（实测行 97.1% / 分支 96.4%，门槛定 95% / 93%）。

                         范围限定在**纯判定逻辑类**：不碰 IO、不依赖 Spring 容器、
                         输入输出都是值，因而「没被单测走到」这件事一定是测试的欠缺。
                         控制器、仓储、消费者、配置那些只有起了 Redis/MySQL 才走得到的代码
                         不在这里 —— 它们由 Testcontainers 集成测试、压测与五条一致性等式覆盖，
                         拿单测覆盖率去要求它们只会逼出为覆盖率而写的假测试。
                         **全仓库行覆盖 9.3% 是这个划分的结果，不是漏测**，
                         数字本身写在 README 里，不藏。 -->
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <!-- ⚠ 这一层 includes 是 class 文件模式，作用是**限定纳入统计的类**。
                                 别写成 rule 里的 includes：那一层过滤的是 element 名字，
                                 而 element 是 BUNDLE 时名字只有一个（"flashpilot"），
                                 列一串类名等于一个都匹配不上 —— 规则会静默地什么都不检查，
                                 阈值调到 0.99 依然 BUILD SUCCESS。这个坑踩过一次。 -->
                            <includes>
                                <include>**/ApptStatus*.class</include>
                                <include>**/Appointment.class</include>
                                <include>**/PatientToken*.class</include>
                                <include>**/CountMinSketch*.class</include>
                                <include>**/ReconcileDecider*.class</include>
                                <include>**/GuardDecider*.class</include>
                                <include>**/ConfigParam*.class</include>
                                <include>**/McpProtocol*.class</include>
                                <include>**/TailModeGate*.class</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.93</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 手写 agent：destfile 必须相对，理由见上面 jacoco 那段注释。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${settings.localRepository}/org/jacoco/org.jacoco.agent/${jacoco.version}/org.jacoco.agent-${jacoco.version}-runtime.jar=destfile=target/jacoco.exec,append=false</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        前端构建。

        默认**不**跑：`frontend/` 的构建产物（682K / 17 个文件）直接纳入版本控制，
        输出目录就是 `src/main/resources/static/app`（见 frontend/vite.config.js 的 outDir），
        所以克隆下来 `mvn package` 就能得到一个前端可用的 jar，**不需要装 Node**。

        这是刻意的取舍。把构建产物提交进仓库通常被认为是坏实践，
        但这个项目的首要用途是「别人能不能跑起来看一眼」——
        而为了看一眼先装 Node、跑 npm install（几百 MB 依赖）门槛太高了。
        682K 换开箱可用，值得。

        改了前端代码的人用这个 profile 重新构建：

            mvn -Pfrontend package

        它要求本地有 Node（开发时用的是 v24）。也可以直接手动跑，效果完全一样：

            cd frontend && npm install && npm run build

        为什么不用 frontend-maven-plugin：它会自己下载一份 Node/npm 到 target 里。
        对 CI 是好事（环境可复现），但对「学生在自己电脑上跑一下」是纯粹的额外等待，
        而且首次构建需要联网下载 Node 发行包。
    -->
    <profiles>
        <profile>
            <id>frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/frontend</workingDirectory>
                                    <arguments><argument>install</argument></arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/frontend</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
